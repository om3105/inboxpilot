# ── LLM Provider ──────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL_NAME=gemini-3.5-flash     # switchable: gemini-3.8-flash, gemini-3.5-flash-lite, etc.
# Optional: cap live LLM requests per minute (Gemini free tier allows 5)
LLM_MAX_RPM=0
# Optional fallback provider: used when Gemini fails (quota, outage, bad output)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b
# Provider order; providers without a key are skipped
LLM_PROVIDERS=gemini,nvidia
# Optional: false uses template drafts instead of the LLM (halves calls per run)
LLM_LIVE_DRAFTS=true

# ── MongoDB Atlas ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=inboxpilot

# ── Langfuse Observability ────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── API Security ──────────────────────────────────────────────
DEMO_TOKEN=change-me-to-a-random-string
# Optional: comma-separated origins allowed to call the API cross-origin
CORS_ORIGINS=

# ── Server ────────────────────────────────────────────────────
PORT=8000
